{
  "name": "@hefuhai001/vue-music-player",
  "version": "0.1.0",
  "description": "A themeable Vue 3 audio player component with four built-in skins: modern, retro, minimal and electronic.",
  "type": "module",
  "license": "MIT",
  "author": "hefuhai001",
  "keywords": [
    "vue",
    "vue3",
    "music-player",
    "audio",
    "audio-player",
    "component",
    "component-library",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hefuhai001/vue-music-player.git"
  },
  "homepage": "https://github.com/hefuhai001/vue-music-player#readme",
  "bugs": {
    "url": "https://github.com/hefuhai001/vue-music-player/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
